{
  "name": "codex-dot-send-motion",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "src",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/api.md",
    "docs/assets/preview.gif"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "demo:build": "vite build",
    "test": "npm run build && node --test tests/ssr.test.mjs",
    "test:browser": "vite --host 127.0.0.1 --open /tests/",
    "prepack": "npm run build",
    "test:package": "node --test tests/package.test.mjs"
  },
  "peerDependencies": {
    "react": ">=19 <20",
    "react-dom": ">=19 <20"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "description": "Reusable React message-send animation inspired by Codex Dot.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wcqqq1214/codex-dot-send-motion.git"
  },
  "homepage": "https://github.com/wcqqq1214/codex-dot-send-motion#readme",
  "bugs": {
    "url": "https://github.com/wcqqq1214/codex-dot-send-motion/issues"
  },
  "keywords": [
    "react",
    "animation",
    "chat",
    "message",
    "web-animations"
  ],
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=22.12.0"
  }
}
